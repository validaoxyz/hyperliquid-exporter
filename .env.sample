# Sample environment variables for the exporter

# Node home directory (default: $HOME/hl, e.g. /home/ubuntu/hl)
NODE_HOME=

# Directory holding the hl-visor/hl-node binaries (default: $HOME).
# The up-to-date check compares $BINARY_HOME/hl-visor against the CDN.
BINARY_HOME=

# Node binary path (default: $BINARY_HOME/hl-node)
NODE_BINARY=
