# Sample environment variables for the exporter

# Node home directory (default: $HOME/hl, e.g. /home/ubuntu/hl)
NODE_HOME=

# Binary settings are used only with --binary-metrics.
# Directory holding hl-visor and hl-node (default: $HOME).
BINARY_HOME=

# Node binary override (default: $BINARY_HOME/hl-node).
NODE_BINARY=
